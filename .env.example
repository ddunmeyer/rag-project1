# Copy this file to .env and replace the value with your actual API key.
# Get a free Gemini API key at: https://aistudio.google.com/apikey
#
# IMPORTANT: Never commit your .env file to git!
# The .env file is listed in .gitignore to prevent accidental exposure.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional — reduce API usage on the free tier (each question uses Gemini calls)
# ENABLE_HALLUCINATION_CHECK=false
# ENABLE_QUERY_REWRITING=true
# GEMINI_MAX_RETRIES=3
